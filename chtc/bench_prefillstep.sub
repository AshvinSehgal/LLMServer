# Why does one prefill step cost ~24-31 ms in the serving run? Submit from the repo root:
#   condor_submit chtc/bench_prefillstep.sub
universe                = docker
docker_image            = pytorch/pytorch:2.5.1-cuda12.1-cudnn9-devel

executable              = chtc/run_bench.sh
arguments               =
environment             = "MODE=prefillstep MODEL_ID=$(model) BACKENDS=custom RUN_TESTS=0 ATTN_BENCH=0 AGREEMENT=0"

transfer_input_files    = utils, tests, benchmark.py, benchmark_cuda.py, diag_prefill_step.py, bench_prompts.py, VERSION
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = llmserver_results.tar.gz
transfer_output_remaps  = "llmserver_results.tar.gz = llmserver_results_$(tag).tar.gz"

log                     = chtc/bench_prefillstep_$(tag)_$(Cluster).log
output                  = chtc/bench_prefillstep_$(tag)_$(Cluster).out
error                   = chtc/bench_prefillstep_$(tag)_$(Cluster).err

request_gpus            = 1
request_cpus            = 4
request_memory          = 64GB
request_disk            = 100GB
+WantGPULab             = true
+GPUJobLength           = "short"
require_gpus = (Capability == 9.0) && regexp("H200", DeviceName)
gpus_minimum_memory     = 80000

queue tag, model from (
  prefillstep-1p7b, Qwen/Qwen3-1.7B
  prefillstep-8b,   Qwen/Qwen3-8B
)
