# Full comparison: Hugging Face vs this engine vs vLLM on one GPU.
# Run chtc/smoke.sub first (a few minutes) to catch Triton / CUDA-graph problems cheaply.
#
# Submit from the repo root on a CHTC submit node:  condor_submit chtc/bench.sub
# (copy the repo there first with chtc/transfer_to_chtc.sh <user@submit-node>)
universe                = docker
# -devel (not -runtime): Triton compiles a small C launcher at run time and needs gcc; torch >= 2.5 is needed for SDPA enable_gqa.
docker_image            = pytorch/pytorch:2.5.1-cuda12.1-cudnn9-devel

executable              = chtc/run_bench.sh
arguments               = --prompt-tokens 128,1024 --batch-sizes 1,8,32 --output-tokens 128 --repeats 3 --dtype bfloat16
environment             = "MODEL_ID=Qwen/Qwen3-1.7B BACKENDS=hf,custom,vllm RUN_TESTS=1 PROFILE=1 ABLATE=1"

# the source directories are copied into the job's top-level directory
transfer_input_files    = utils, tests, benchmark.py, benchmark_cuda.py
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = llmserver_results.tar.gz

log                     = chtc/bench_$(Cluster).log
output                  = chtc/bench_$(Cluster).out
error                   = chtc/bench_$(Cluster).err

request_gpus            = 1
request_cpus            = 4
request_memory          = 32GB
request_disk            = 50GB
+WantGPULab             = true
+GPUJobLength           = "short"
# bfloat16 and the Triton kernels want compute capability >= 8.0 (A100 / H100); this also keeps results comparable between runs.
gpus_minimum_capability = 8.0
# Qwen3-1.7B at batch 32 x 1024 tokens fits easily in 24 GB.
gpus_minimum_memory     = 24000

queue
