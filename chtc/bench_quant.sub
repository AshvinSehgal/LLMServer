# int8 weight-only on an H200: GEMM microbenchmark, WikiText-2 perplexity (bf16 vs int8) and the end-to-end benchmark
# (this engine bf16, this engine int8, vLLM bf16). Submit from the repo root:  condor_submit chtc/bench_quant.sub
universe                = docker
docker_image            = pytorch/pytorch:2.5.1-cuda12.1-cudnn9-devel

executable              = chtc/run_bench.sh
arguments               = --prompt-tokens 128,1024 --batch-sizes 1,8,32 --output-tokens 128 --repeats 3 --dtype bfloat16
environment             = "MODEL_ID=$(model) BACKENDS=hf,custom,custom-int8,vllm RUN_TESTS=1 PROFILE=0 ABLATE=0 ATTN_BENCH=0 AGREEMENT=0 GEMM=1 QUALITY=1"

transfer_input_files    = utils, tests, benchmark.py, benchmark_cuda.py, agreement_check.py, bench_attention.py, bench_prompts.py, bench_spec.py, bench_spec_vllm.py, bench_gemm.py, eval_quality.py, VERSION
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = llmserver_results.tar.gz
transfer_output_remaps  = "llmserver_results.tar.gz = llmserver_results_$(tag).tar.gz"

log                     = chtc/bench_quant_$(tag)_$(Cluster).log
output                  = chtc/bench_quant_$(tag)_$(Cluster).out
error                   = chtc/bench_quant_$(tag)_$(Cluster).err

request_gpus            = 1
request_cpus            = 4
request_memory          = 64GB
request_disk            = 100GB
+WantGPULab             = true
+GPUJobLength           = "short"
require_gpus = (Capability == 9.0) && regexp("H200", DeviceName)
gpus_minimum_memory     = 80000

queue tag, model from (
  quant-8b,  Qwen/Qwen3-8B
  quant-14b, Qwen/Qwen3-14B
)
