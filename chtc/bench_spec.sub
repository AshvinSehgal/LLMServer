# Speculative decoding on an H200: this engine plain vs with a small draft model (and vLLM's numbers where it supports draft models).
# Batch 1, natural chat prompts. Submit from the repo root:  condor_submit chtc/bench_spec.sub
# Each job writes llmserver_results_<tag>.tar.gz; read STATUS.txt (engine and vLLM lines are copied into it).
universe                = docker
docker_image            = pytorch/pytorch:2.5.1-cuda12.1-cudnn9-devel

executable              = chtc/run_bench.sh
arguments               =
environment             = "MODE=spec MODEL_ID=$(model) DRAFT_ID=$(draft) DRAFT_TOKENS=$(ks) NEW_TOKENS=128 BACKENDS=vllm RUN_TESTS=0 ATTN_BENCH=0 AGREEMENT=0"

transfer_input_files    = utils, tests, benchmark.py, benchmark_cuda.py, agreement_check.py, bench_attention.py, bench_prompts.py, bench_spec.py, bench_spec_vllm.py, VERSION
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = llmserver_results.tar.gz
transfer_output_remaps  = "llmserver_results.tar.gz = llmserver_results_$(tag).tar.gz"

log                     = chtc/bench_spec_$(tag)_$(Cluster).log
output                  = chtc/bench_spec_$(tag)_$(Cluster).out
error                   = chtc/bench_spec_$(tag)_$(Cluster).err

request_gpus            = 1
request_cpus            = 4
request_memory          = 64GB
request_disk            = 100GB
+WantGPULab             = true
+GPUJobLength           = "short"
require_gpus = (Capability == 9.0) && regexp("H200", DeviceName)
gpus_minimum_memory     = 80000

queue tag, model, draft, ks from (
  spec-8b-0p6b,  Qwen/Qwen3-8B,  Qwen/Qwen3-0.6B, "3,5,7"
  spec-14b-0p6b, Qwen/Qwen3-14B, Qwen/Qwen3-0.6B, "3,5,7"
  spec-14b-1p7b, Qwen/Qwen3-14B, Qwen/Qwen3-1.7B, "3,5"
)
